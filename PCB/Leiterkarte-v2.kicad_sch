	(lib_symbols)
	(text_box "PCB:\nX - Longer pads on the USB-C port and Inductor\nX - Bigger JST connectors\nX - More GND vias\nX - Put Power Supply on the upper side\nX - Maybe make one shield plane to 3.3V\nX - Thermal Relief Pads fix\nX - Update Trace Widths\nX - Remove Component Names like \"R22\"\nX - Invert Texts: White Box, transparent Text (min 1.5mm text height)\n\nCircuit:\nX - Adding Testpoints\nX - Bigger Cin1 (i guess) [Added place for another cap]\nX - New speed circuit incl. pulldown for speed line\nX - Update RPM and indicator circuits\nX - Filter cap on the RPM line?\nX - Connect USB-C 5V to the internal 5V rail\nX - Adding filtering\n\nX = Done"
		(exclude_from_sim no)
