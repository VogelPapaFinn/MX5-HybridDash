    },
    {
      "id": "_UCXyIoR3G2yVm3PVgeDo",
      "type": "text",
      "x": 2950.676879475049,
      "y": 675.5825609965118,
      "width": 686.1666870117188,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
