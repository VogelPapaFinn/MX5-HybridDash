    {
      "id": "tI6sI_oyhPD93_-a2QjfH",
      "type": "text",
      "x": 1790.4866672276312,
      "y": 202.05571322163587,
      "width": 597.9666748046875,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "37--kVehDsEOTDZoSBJzg"
      ],
      "frameId": null,
      "index": "b15",
      "roundness": null,
      "seed": 211948543,
      "version": 3629,
      "versionNonce": 867368063,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778002200059,
      "link": null,
      "locked": false,
      "text": "\nCAN:\n    - Header ID (29 Bit) Format:\n        3 Bits  -> Sender: Master = 001, Slaves = 010 bis 111\n        3 Bits  -> Target: 0 = Broadcast\n        4 Bits  -> Group e.g. Sensor, WiFi Ctrl, Update Ctrl, etc.\n        5 Bits  -> Group Function e.g. New Sensor Value, Connect to WiFi etc.\n        4 Bits  -> Data Payload Length: 0 = empty\n        1 Bits  -> Request = 0, Antwort = 1\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "kH5V9R-RL5PjSTtY-arg_",
      "originalText": "\nCAN:\n    - Header ID (29 Bit) Format:\n        3 Bits  -> Sender: Master = 001, Slaves = 010 bis 111\n        3 Bits  -> Target: 0 = Broadcast\n        4 Bits  -> Group e.g. Sensor, WiFi Ctrl, Update Ctrl, etc.\n        5 Bits  -> Group Function e.g. New Sensor Value, Connect to WiFi etc.\n        4 Bits  -> Data Payload Length: 0 = empty\n        1 Bits  -> Request = 0, Antwort = 1\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
