      "seed": 1320605617,
      "version": 4299,
      "versionNonce": 135990335,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778002553812,
      "link": null,
      "locked": false,
      "text": "\n- KLine should be initialized when everything else is setup, as its not mandatory for the\n  PCBs to work and it could take a few seconds until the ECU is ready for \n  communicating\n- Implement a console for the SensorBoard to send & test stuff easily\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "sRnorpeQTWx3q9QmKWsmX",
      "originalText": "\n- KLine should be initialized when everything else is setup, as its not mandatory for the\n  PCBs to work and it could take a few seconds until the ECU is ready for \n  communicating\n- Implement a console for the SensorBoard to send & test stuff easily\n",
      "autoResize": true,
      "lineHeight": 1.25
